/* 完善资料 */

.profile-page {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: #0d0d0d;
  display: flex;
  flex-direction: column;
}

.status-bar {
  flex: 0 0 auto;
}

/* ============================================================
   顶部导航
   ============================================================ */

.nav {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  position: relative;
}

.back {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #c8c6c1;
  line-height: 1;
  padding-bottom: 6rpx;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 30rpx;
  letter-spacing: 0.1em;
  color: #f0efec;
}

/* ============================================================
   底部保存按钮
   
   放在这里而不是右上角：
     右上角是微信系统画的胶囊按钮，页面元素盖不住它，
     放那里会重叠、点不到。
   ============================================================ */

.footer {
  flex: 0 0 auto;
  padding: 24rpx 48rpx 48rpx;
  /* 底部安全区（iPhone 刘海屏的横条） */
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.save-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 14rpx;
  border: 1rpx solid #c9a86a;
  background: rgba(201, 168, 106, 0.11);
  color: #c9a86a;
  font-size: 30rpx;
  letter-spacing: 0.24em;
  text-indent: 0.24em;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.save-btn.is-disabled {
  opacity: 0.45;
}

/* ============================================================
   内容区
   ============================================================ */

.content {
  flex: 1;
  padding: 40rpx 48rpx;
  overflow-y: auto;
}

/* ---------- 头像 ---------- */

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
}

.avatar-wrap {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  overflow: visible;
}

.avatar {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  display: block;
}

.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(201, 168, 106, 0.1);
  border: 1rpx solid rgba(201, 168, 106, 0.28);
  box-sizing: border-box;
}

.avatar-initial {
  font-family: "Songti SC", "SimSun", serif;
  font-size: 66rpx;
  color: #c9a86a;
  line-height: 1;
}

/* 右下角的相机小标 */
.avatar-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #1a1a1a;
  border: 1rpx solid rgba(201, 168, 106, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.avatar-hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  letter-spacing: 0.04em;
  color: #5a5956;
}

/* ---------- 昵称 ---------- */

.field {
  position: relative;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(240, 239, 236, 0.09);
}

.field-label {
  font-size: 24rpx;
  letter-spacing: 0.08em;
  color: #8a8884;
  margin-bottom: 18rpx;
}

.field-input {
  width: 100%;
  font-size: 32rpx;
  letter-spacing: 0.04em;
  color: #f0efec;
  /* 给右下角计数留位置 */
  padding-right: 100rpx;
  box-sizing: border-box;
}

.ph {
  color: #3d3c3a;
}

.field-count {
  position: absolute;
  right: 0;
  bottom: 20rpx;
  font-size: 22rpx;
  color: #3d3c3a;
}

/* ---------- 说明 ---------- */

.tip {
  margin-top: 48rpx;
  font-size: 24rpx;
  line-height: 1.85;
  letter-spacing: 0.02em;
  color: #5a5956;
}
