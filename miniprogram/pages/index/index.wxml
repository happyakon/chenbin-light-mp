<!--
  首页 —— 介绍页
  
  ★ 结构说明
  
  背景层（两种，二选一）：
    · 有后台配置的背景图 → 显示真实照片
    · 没有 → 用 CSS 绘制的默认星空山景
  
  内容层：
    欢迎语 → 主标题 → 副标题 → 卡片 → 引导
  
  ★ 文字默认值写死在 WXML，JS 拿到配置后才覆盖。
    即使接口失败，页面也能正常显示。
-->
<view class="index-page" bindtap="onTapScreen">
  <!-- ============ 背景层 ============ -->
  <!--
    有配置背景图时：
      用真实照片铺满，底部加渐变让文字可读。
    image 用 aspectFill 铺满，不用 CSS background-image 
    因为 image 组件有缓存和性能优化。
  -->
  <block wx:if="{{hasBg}}">
    <image class="bg-photo" src="{{bgImage}}" mode="aspectFill" />
    <!-- 顶部渐变（让文字可读） -->
    <view class="bg-shade-top"></view>
    <!-- 底部渐变（让卡片和引导可读） -->
    <view class="bg-shade-bottom"></view>
  </block>

  <!-- 没有配置背景图时：CSS 绘制的星空山景 -->
  <block wx:else>
    <!-- 星空 -->
    <view class="stars">
      <view class="star" style="left:8%;top:14%;animation-delay:0s;animation-duration:3.2s"></view>
      <view class="star" style="left:19%;top:32%;animation-delay:1.1s;animation-duration:4.1s"></view>
      <view class="star" style="left:27%;top:8%;animation-delay:2.4s;animation-duration:3.6s"></view>
      <view class="star" style="left:34%;top:41%;animation-delay:0.6s;animation-duration:4.8s"></view>
      <view class="star" style="left:43%;top:19%;animation-delay:3.2s;animation-duration:3.4s"></view>
      <view class="star" style="left:51%;top:36%;animation-delay:1.8s;animation-duration:4.4s"></view>
      <view class="star" style="left:58%;top:11%;animation-delay:2.9s;animation-duration:3.9s"></view>
      <view class="star" style="left:66%;top:28%;animation-delay:0.3s;animation-duration:5.1s"></view>
      <view class="star" style="left:74%;top:44%;animation-delay:3.7s;animation-duration:3.3s"></view>
      <view class="star" style="left:81%;top:16%;animation-delay:1.5s;animation-duration:4.6s"></view>
      <view class="star" style="left:89%;top:33%;animation-delay:2.2s;animation-duration:3.7s"></view>
      <view class="star" style="left:12%;top:52%;animation-delay:4.0s;animation-duration:4.2s"></view>
      <view class="star" style="left:23%;top:61%;animation-delay:1.3s;animation-duration:3.5s"></view>
      <view class="star" style="left:38%;top:55%;animation-delay:2.7s;animation-duration:4.9s"></view>
      <view class="star" style="left:47%;top:66%;animation-delay:0.9s;animation-duration:3.8s"></view>
      <view class="star" style="left:62%;top:58%;animation-delay:3.5s;animation-duration:4.3s"></view>
      <view class="star" style="left:77%;top:68%;animation-delay:1.9s;animation-duration:3.1s"></view>
      <view class="star" style="left:92%;top:57%;animation-delay:2.6s;animation-duration:4.7s"></view>
    </view>

    <!-- 地平线的光 -->
    <view class="light-outer"></view>
    <view class="light-inner"></view>

    <!-- 远山 -->
    <view class="mountain-far"></view>
    <!-- 近山 -->
    <view class="mountain-near"></view>
  </block>

  <!-- ============ 内容层 ============ -->
  <view class="status-bar" style="height:{{statusBarHeight}}px"></view>

  <view class="head">
    <view class="welcome">欢迎来到我的拾光集</view>
    <view class="title">{{title}}</view>
    <view class="subtitle">{{subtitle}}</view>
  </view>

  <!-- 占位：把卡片推到底部 -->
  <view class="spacer"></view>

  <view class="card">
    <view class="card-title">{{cardTitle}}</view>
    <view class="card-body">{{cardBody}}</view>
  </view>

  <view class="enter">
    <view class="enter-line"></view>
    <view class="enter-text">轻触进入</view>
    <view class="enter-arrow">↓</view>
  </view>
</view>
