/* 摄影集页 —— 顶部横向筛选 + 相册双列网格 */

.collections-page {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  background: #0d0d0d;
  overflow: hidden;
}

.status-bar {
  flex: 0 0 auto;
}

/* ---------------------------------------------------------- 顶部标题 */

.page-head {
  flex: 0 0 auto;
  padding: 20rpx 36rpx 20rpx;
}

.page-title {
  font-family: "Songti SC", "SimSun", serif;
  font-size: 44rpx;
  letter-spacing: 0.16em;
  color: #f0efec;
}

/* ---------------------------------------------------------- 横向筛选 chip */

.chips {
  flex: 0 0 auto;
  white-space: nowrap;
  padding: 0 36rpx 24rpx;
  display: flex;
  box-sizing: border-box;
}

.chip {
  display: inline-flex;
  align-items: center;
  flex: 0 0 auto;
  height: 60rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(240, 239, 236, 0.1);
  font-size: 24rpx;
  letter-spacing: 0.04em;
  color: #8a8884;
  transition: all 0.24s ease;
}

.chip.is-active {
  border-color: #c9a86a;
  color: #c9a86a;
  background: rgba(201, 168, 106, 0.1);
}

/* ---------------------------------------------------------- 滚动区 */

.scroll-area {
  flex: 1;
  min-height: 0;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

/* ---------------------------------------------------------- 相册网格 */

.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.album {
  /*
   * 双列布局，宽度必须算上 margin-right，否则总宽超 50% 会掉成单列。
   * padding 28×2 = 56，间距 16，所以单列 = (100% - 72) / 2
   */
  width: calc((100% - 72rpx) / 2);
  margin-bottom: 22rpx;
  opacity: 0;
  transform: translate(0, 24rpx) scale(0.94);
  transition: opacity 0.4s ease-out, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
}

/* 左列留间距 */
.album:nth-child(odd) {
  margin-right: 16rpx;
}

/* 奇偶方向不同，制造错落感 */
.album.from-left {
  transform: translate(-8rpx, 24rpx) scale(0.94);
}

.album.from-right {
  transform: translate(8rpx, 24rpx) scale(0.94);
}

.album.is-in {
  opacity: 1;
  transform: translate(0, 0) scale(1);
}

.cover-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 3 / 4;
  border-radius: 8rpx;
  overflow: hidden;
  background: #141414;
  box-shadow: 0 6rpx 28rpx rgba(0, 0, 0, 0.5);
}

.cover {
  width: 100%;
  height: 100%;
  display: block;
}

/*
 * 虚化封面
 *
 * 图片本身已经在后端 blur 过了（?tier=blur），
 * 这里只做「压暗 + 降饱和」的处理，
 * 让它在视觉上更沉，和旁边正常封面区分开。
 *
 * 注意：不能用 filter: blur()（小程序 WXSS 不支持），
 * 所以真正的模糊全靠后端。
 */
.cover.is-blurred {
  opacity: 0.72;
}

/*
 * 「需要密码」小标签
 *
 * 放在右上角锁标记下方，用金色半透明底，
 * 让人一眼知道这不是网络错误，是要密码。
 */
.need-pass {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(201, 168, 106, 0.42);
  background: rgba(0, 0, 0, 0.55);
  font-size: 18rpx;
  letter-spacing: 0.06em;
  color: rgba(201, 168, 106, 0.9);
  z-index: 3;
}

/* ============================================================
   虚化封面中间的「锁 + PRIVATE GALLERY」
   
   占据卡片宽度的一半，水平垂直居中。
   为什么用 50% 宽：
     太小看不清是什么，太大又盖住封面本身。
     一半宽刚好能放下「线框锁 + 一行英文」，同时保留封面辨识度。
   ============================================================ */

.lock-overlay {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
  /* 不拦截点击，整张卡片都是点击区域 */
  pointer-events: none;
}

/*
 * 锁图标
 *
 * 用固定 rpx 而不是百分比：
 *   <image> 用百分比高度时在部分机型上会被压成 0，
 *   rpx 按屏宽换算，各机型比例一致。
 *
 * 48×56 rpx 是 viewBox 24×28 的两倍，等比不变形。
 */
.lock-overlay-svg {
  width: 48rpx;
  height: 56rpx;
  display: block;
}

/*
 * PRIVATE GALLERY
 *
 * 字号用 rpx 固定值而不是百分比：
 * 百分比字号在小程序里表现不稳定。
 * 卡片实际宽度约 330rpx，17rpx 的字母刚好一行放得下。
 */
.lock-overlay-text {
  margin-top: 14rpx;
  font-size: 17rpx;
  letter-spacing: 0.2em;
  /* 字距会在末尾多算一段空白，用 text-indent 补回来才真正居中 */
  text-indent: 0.2em;
  color: rgba(201, 168, 106, 0.9);
  text-transform: uppercase;
  white-space: nowrap;
}

/* ============================================================
   加锁相册的占位封面
   
   未解锁时不显示真实封面（后端故意不返回），
   所以这里要做一块「看起来是有意设计」的锁屏，
   而不是一块纯黑 + 一个 emoji。
   
   和相册解锁页用同一套视觉语言：暗底 + 金色光晕 + 细网格。
   ============================================================ */

.cover-empty {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /*
   * 斜向渐变。
   *
   * 亮度比之前提高了一档（#1c1c22 → #141418）：
   * 卡片在网格里要和旁边有实拍封面的相册并列，
   * 太黑会让整列看起来「缺了一块」。
   */
  background: linear-gradient(158deg, #1c1c22 0%, #141418 48%, #0e0e11 100%);
  overflow: hidden;
}

/* 中心金色光晕 */
.empty-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 280rpx;
  height: 280rpx;
  margin-left: -140rpx;
  margin-top: -140rpx;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(201, 168, 106, 0.15) 0%,
    rgba(201, 168, 106, 0.06) 34%,
    rgba(201, 168, 106, 0.016) 56%,
    rgba(201, 168, 106, 0) 74%
  );
}

/* 细网格纹理，和展开页呼应 */
.empty-grid {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  /*
   * 卡片只有 165px 宽，网格太密会显得乱。
   * 间距 56rpx（约 28px），透明度 0.025 ——
   * 比解锁页（整屏）更淡，因为这里的观看距离更近。
   */
  background-image: linear-gradient(
      to right,
      rgba(240, 239, 236, 0.025) 1px,
      transparent 1px
    ),
    linear-gradient(
      to bottom,
      rgba(240, 239, 236, 0.025) 1px,
      transparent 1px
    );
  background-size: 56rpx 56rpx;
  background-position: center top;
}

/* 锁：圆环 + 图标 */
.lock-badge {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lock-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 96rpx;
  height: 96rpx;
  margin-left: -48rpx;
  margin-top: -48rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(201, 168, 106, 0.3);
  background: rgba(201, 168, 106, 0.03);
  box-sizing: border-box;
}

/*
 * 兜底占位里的锁（无封面 + 加锁时才会显示）
 *
 * 用 SVG 而不是 emoji，和卡片其它锁标记风格一致。
 * 尺寸比中间叠加层的稍大：这里没有封面背景干扰，可以显眼一点。
 */
.lock-svg {
  position: relative;
  width: 52rpx;
  height: 60rpx;
  display: block;
}

.empty-caption {
  position: relative;
  margin-top: 18rpx;
  font-size: 20rpx;
  letter-spacing: 0.22em;
  text-indent: 0.22em;
  color: rgba(201, 168, 106, 0.5);
}

.cover-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 55%;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.85) 0%,
    rgba(0, 0, 0, 0.15) 55%,
    transparent 100%
  );
  pointer-events: none;
}

.cover-text {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 18rpx;
  z-index: 2;
}

.cn {
  font-family: "Songti SC", "SimSun", serif;
  font-size: 32rpx;
  letter-spacing: 0.08em;
  color: #fff;
  text-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.8);
  line-height: 1.3;
}

.en {
  margin-top: 6rpx;
  font-size: 17rpx;
  letter-spacing: 0.18em;
  /*
   * 和 PC 端保持一致用金色（--gold 是 #c9a86a）。
   * 原来是 rgba(255,255,255,.55) 白色，
   * 放在实拍封面和虚化封面上都显平淡。
   *
   * 透明度 0.85：太实会盖过上面的中文标题，
   * 中文是主，英文是辅。
   */
  color: rgba(201, 168, 106, 0.85);
  text-transform: uppercase;
}

.badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  /*
   * 原来用 backdrop-filter: blur() 做毛玻璃，
   * 但小程序 WXSS 不支持这个属性，等于没写。
   * 改成稍高的不透明度 + 细边框，视觉上更明确。
   */
  border: 1rpx solid rgba(201, 168, 106, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  z-index: 3;
}

/*
 * 徽章里的锁
 *
 * 48rpx 的圆里放 22rpx 的锁，四周留 13rpx 边距。
 * 用 SAME 的 SVG 图标（不是 emoji），和中间的大锁风格统一。
 */
.badge-lock {
  width: 22rpx;
  height: 26rpx;
  display: block;
}

.count {
  margin-top: 12rpx;
  font-size: 22rpx;
  letter-spacing: 0.06em;
  color: #5a5956;
}

/* ---------------------------------------------------------- 骨架屏 */

.skeleton-wrap {
  opacity: 1;
  transform: none;
}

.sk-line {
  height: 20rpx;
  border-radius: 4rpx;
  margin-top: 12rpx;
}

.meta {
  padding: 0 4rpx;
}
