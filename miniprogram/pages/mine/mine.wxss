/* 我的 */

.mine-page {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: #0d0d0d;
  overflow-y: auto;
  /* 原生 tabBar 由系统占位，这里只留呼吸空间 */
  padding-bottom: 40rpx;
}

.status-bar {
  flex: 0 0 auto;
}

.page-head {
  padding: 20rpx 36rpx 40rpx;
}

.page-title {
  font-family: "Songti SC", "SimSun", serif;
  font-size: 44rpx;
  letter-spacing: 0.16em;
  color: #f0efec;
}

/* ============================================================
   资料卡片
   ============================================================ */

.profile-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin: 0 36rpx 44rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(240, 239, 236, 0.08);
  background: rgba(255, 255, 255, 0.018);
}

/* 头像是圆的，overflow hidden 保证不溢出圆角 */
.avatar-wrap {
  flex: 0 0 auto;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  overflow: hidden;
  position: relative;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  display: block;
}

/* 没头像时的占位：暗金圆形 + 首字母 */
.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(201, 168, 106, 0.1);
  border: 1rpx solid rgba(201, 168, 106, 0.28);
}

.avatar-initial {
  font-family: "Songti SC", "SimSun", serif;
  font-size: 44rpx;
  color: #c9a86a;
  line-height: 1;
}

.profile-body {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 32rpx;
  letter-spacing: 0.04em;
  color: #f0efec;
  /* 昵称太长时省略 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  letter-spacing: 0.03em;
  color: #5a5956;
}

.profile-arrow {
  flex: 0 0 auto;
  font-size: 32rpx;
  color: #5a5956;
}

.list {
  border-top: 1rpx solid rgba(240, 239, 236, 0.07);
}

.row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx;
  border-bottom: 1rpx solid rgba(240, 239, 236, 0.055);
}

.row-icon {
  width: 36rpx;
  font-size: 32rpx;
  color: #8a8884;
  text-align: center;
}

.row-label {
  flex: 1;
  font-size: 30rpx;
  letter-spacing: 0.04em;
  color: #c8c6c1;
}

.row-value {
  font-size: 24rpx;
  color: #5a5956;
}

.row-arrow {
  font-size: 32rpx;
  color: #5a5956;
}
