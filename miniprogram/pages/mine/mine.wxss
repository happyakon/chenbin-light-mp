/* 我的 */

.mine-page {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: #0d0d0d;
  overflow-y: auto;
  /* 原生 tabBar 由系统占位，这里只留呼吸空间 */
  padding-bottom: 40rpx;
}

.status-bar {
  flex: 0 0 auto;
}

.page-head {
  padding: 20rpx 36rpx 40rpx;
}

.page-title {
  font-family: "Songti SC", "SimSun", serif;
  font-size: 44rpx;
  letter-spacing: 0.16em;
  color: #f0efec;
}

.list {
  border-top: 1rpx solid rgba(240, 239, 236, 0.07);
}

.row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx;
  border-bottom: 1rpx solid rgba(240, 239, 236, 0.055);
}

.row-icon {
  width: 36rpx;
  font-size: 32rpx;
  color: #8a8884;
  text-align: center;
}

.row-label {
  flex: 1;
  font-size: 30rpx;
  letter-spacing: 0.04em;
  color: #c8c6c1;
}

.row-value {
  font-size: 24rpx;
  color: #5a5956;
}

.row-arrow {
  font-size: 32rpx;
  color: #5a5956;
}
