<view class="mine-page">
  <view class="status-bar" style="height:{{statusBarHeight}}px"></view>

  <view class="page-head">
    <view class="page-title">我的</view>
  </view>

  <view class="list">
    <view class="row" bindtap="goFavorites">
      <text class="row-icon">☆</text>
      <text class="row-label">我的收藏</text>
      <text class="row-value">{{favCount === null ? '' : favCount + ' 张'}}</text>
      <text class="row-arrow">›</text>
    </view>

    <view class="row" bindtap="goLikes">
      <text class="row-icon">♡</text>
      <text class="row-label">我的点赞</text>
      <text class="row-value">{{likeCount === null ? '' : likeCount + ' 张'}}</text>
      <text class="row-arrow">›</text>
    </view>
  </view>
</view>
