/* 相册浏览页 —— 核心交互 */

.album-page {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: #000;
  overflow: hidden;
  /* 照片墙模式下需要纵向 flex：标题栏固定，瀑布流撑满剩余 */
  display: flex;
  flex-direction: column;
}

/* ---------------------------------------------------------- 顶部返回 */

.top-bar {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  padding-left: 20rpx;
  padding-bottom: 8rpx;
  pointer-events: none;
}

.back-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(16rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #c8c6c1;
  line-height: 1;
  padding-bottom: 6rpx;
  pointer-events: auto;
}

.full-center {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ==========================================================
   视图 1：封面 + 瀑布流
   ========================================================== */

.wall-scroll {
  flex: 1;
  min-height: 0;
}

/* ---------------------------------------------------------- 顶部大封面 */

.hero {
  position: relative;
  width: 100%;
  /*
   * 4:3 横版封面 —— 比之前的 3:4 竖版矮一半。
   * 为什么改成横的：竖版封面占满整屏，瀑布流要滑很久才看到，
   * 横版能一眼看到「封面 + 下面几张照片」。
   */
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background: #141414;
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-empty {
  background: linear-gradient(160deg, #1a1a1a 0%, #0f0f0f 100%);
}

/* 底部渐变，让标题浮在图上也能看清（横版封面较矮，遮罩收窄） */
.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 45%;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.88) 0%,
    rgba(0, 0, 0, 0.42) 45%,
    transparent 100%
  );
  pointer-events: none;
}

.hero-back {
  position: absolute;
  left: 24rpx;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.42);
  backdrop-filter: blur(16rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #fff;
  line-height: 1;
  padding-bottom: 6rpx;
  z-index: 10;
}

.hero-text {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 28rpx;
  z-index: 5;
}

.hero-title {
  font-family: "Songti SC", "SimSun", serif;
  font-size: 44rpx;
  letter-spacing: 0.1em;
  color: #fff;
  line-height: 1.25;
  text-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.75);
  /* 横版封面空间有限，最多两行 */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.hero-count {
  margin-top: 8rpx;
  font-size: 22rpx;
  letter-spacing: 0.06em;
  color: rgba(255, 255, 255, 0.62);
}

/* ---------------------------------------------------------- 瀑布流 */

.masonry {
  display: flex;
  gap: 8rpx;
  padding: 20rpx 20rpx calc(60rpx + env(safe-area-inset-bottom));
}

.m-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.m-item {
  width: 100%;
  border-radius: 6rpx;
  overflow: hidden;
  background: #141414;
}

.m-img {
  width: 100%;
  display: block;
}

/* ==========================================================
   视图 2：全屏沉浸浏览
   ========================================================== */

/* ---------------------------------------------------------- 照片区 */

.stage {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  /* 展开时高度缩到 52%，用 height 过渡 */
  transition: height 0.26s cubic-bezier(0.16, 1, 0.3, 1);
  height: 100%;
  z-index: 10;
  background: #000;
}

.stage.is-expanded {
  height: 52%;
}

/* 拖动时关掉过渡，实现跟手 */
.stage.is-dragging {
  transition: none;
}

.photo-swiper {
  width: 100%;
  height: 100%;
}

.photo-box {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 容器始终占满照片区，图片用 aspectFit/aspectFill 自己适配 */
  overflow: hidden;
}

.photo {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* thumb 在下层做占位，medium 覆盖上去 */
.photo.thumb {
  z-index: 1;
}

.photo.medium {
  z-index: 2;
}

/* 上滑提示 */
.slide-hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 130rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  z-index: 15;
  pointer-events: none;
  animation: hintFloat 2.4s ease-in-out infinite;
}

.hint-arrow {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.32);
}

.hint-text {
  font-size: 21rpx;
  letter-spacing: 0.16em;
  color: rgba(255, 255, 255, 0.32);
}

@keyframes hintFloat {
  0%,
  100% {
    transform: translateY(0);
    opacity: 0.5;
  }
  50% {
    transform: translateY(-12rpx);
    opacity: 0.95;
  }
}

/* ---------------------------------------------------------- EXIF 面板 */

.exif-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 48%;
  background: rgba(13, 13, 13, 0.98);
  backdrop-filter: blur(24rpx);
  border-top: 1rpx solid rgba(240, 239, 236, 0.09);
  border-radius: 24rpx 24rpx 0 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  /* 收起时整体推到屏幕外 */
  transform: translateY(100%);
  transition: transform 0.26s cubic-bezier(0.16, 1, 0.3, 1);
}

.exif-panel.is-open {
  transform: translateY(0);
}

.exif-panel.is-dragging {
  transition: none;
}

.panel-handle {
  flex: 0 0 auto;
  padding: 16rpx 0 12rpx;
  display: flex;
  justify-content: center;
}

.panel-bar {
  width: 68rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(240, 239, 236, 0.18);
}

.exif-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 40rpx;
}

.exif-list {
  padding-bottom: 24rpx;
}

.exif-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(240, 239, 236, 0.045);
}

.exif-row:last-child {
  border-bottom: 0;
}

.ek {
  flex: 0 0 auto;
  width: 120rpx;
  font-size: 20rpx;
  letter-spacing: 0.14em;
  color: #5a5956;
}

.ev {
  flex: 1;
  text-align: right;
  font-size: 24rpx;
  letter-spacing: 0.02em;
  color: #c8c6c1;
  line-height: 1.5;
  word-break: break-word;
}

.no-exif {
  padding: 80rpx 0;
  text-align: center;
  font-size: 24rpx;
  letter-spacing: 0.1em;
  color: #5a5956;
}

/* ---------------------------------------------------------- 底部信息条 */

.info-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 25;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(0, 0, 0, 0.9), transparent);
  transition: transform 0.26s cubic-bezier(0.16, 1, 0.3, 1);
}

/* 展开时信息条跟着面板上移 */
.info-bar.is-up {
  transform: translateY(0);
  background: rgba(13, 13, 13, 0.98);
  border-top: 1rpx solid rgba(240, 239, 236, 0.07);
}

.info-left {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  min-width: 0;
}

.album-name {
  font-family: "Songti SC", "SimSun", serif;
  font-size: 30rpx;
  letter-spacing: 0.1em;
  color: #f0efec;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.counter {
  font-size: 22rpx;
  letter-spacing: 0.08em;
  color: rgba(255, 255, 255, 0.45);
  flex: 0 0 auto;
}

.info-right {
  display: flex;
  align-items: center;
  gap: 32rpx;
  flex: 0 0 auto;
}

.act {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx;
}

.act-icon {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1;
  transition: color 0.2s ease, transform 0.2s ease;
}

.act-icon.is-liked {
  color: #d9705f;
  transform: scale(1.1);
}

.act-icon.is-faved {
  color: #c9a86a;
  transform: scale(1.1);
}

.act-num {
  font-size: 24rpx;
  letter-spacing: 0.02em;
  color: rgba(255, 255, 255, 0.65);
}
