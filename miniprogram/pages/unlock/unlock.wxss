/* ============================================================
   相册解锁页
   ============================================================ */

.unlock-page {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: #0d0d0d;
  display: flex;
  flex-direction: column;
}

.status-bar {
  flex: 0 0 auto;
}

.nav {
  flex: 0 0 auto;
  padding: 12rpx 20rpx;
}

.back {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #c8c6c1;
  line-height: 1;
  padding-bottom: 6rpx;
}

.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 左右 88rpx 内边距，底部多留白让内容重心上移 */
  padding: 0 88rpx 220rpx;
  box-sizing: border-box;
}

/* ============================================================
   锁图标
   ============================================================ */

.lock-icon {
  font-size: 76rpx;
  margin-bottom: 40rpx;
  opacity: 0.85;
}

/* ============================================================
   标题与说明
   ============================================================ */

.album-title {
  font-family: "Songti SC", "SimSun", serif;
  font-size: 48rpx;
  letter-spacing: 0.14em;
  color: #f0efec;
  text-align: center;
}

.hint {
  margin-top: 20rpx;
  font-size: 26rpx;
  letter-spacing: 0.06em;
  color: #8a8884;
  text-align: center;
}

/* ============================================================
   输入框
   ============================================================ */

.input-wrap {
  /*
   * ★ 用 align-self: stretch 撑满
   *
   * .content 是 align-items: center 的 flex 容器，
   * width: 100% 在这种容器里表现不稳定，用 stretch 最可靠。
   */
  align-self: stretch;
  margin-top: 80rpx;
}

.input {
  width: 100%;
  height: 100rpx;
  border: 1rpx solid rgba(240, 239, 236, 0.14);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.02);
  color: #f0efec;
  font-size: 32rpx;
  letter-spacing: 0.1em;
  text-align: center;
  box-sizing: border-box;
}

.input-ph {
  color: #3d3c3a;
  font-size: 28rpx;
  letter-spacing: 0.06em;
}

/* 输错抖动 */
.is-shake {
  animation: shake 0.4s ease;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-14rpx); }
  40% { transform: translateX(14rpx); }
  60% { transform: translateX(-10rpx); }
  80% { transform: translateX(10rpx); }
}

/* ============================================================
   进入按钮
   
   ★ 用 <view> 而不是 <button>
   
   小程序的 <button> 有独立的宽度计算逻辑，
   实测以下方式都无法让它和输入框等宽：
     · width: 100%
     · 包一层 width: 100% 的父 view
     · align-self: stretch
   按钮永远比输入框窄一截。
   
   换成 <view> 后 width: 100% 立刻生效。
   样式本来就是自己写的，视觉上和 button 完全一样。
   ============================================================ */

.submit {
  /*
   * 和 .input-wrap 用同样的方式撑满，
   * 保证两者宽度严格一致。
   */
  align-self: stretch;
  width: 100%;
  height: 100rpx;
  margin-top: 28rpx;
  border-radius: 16rpx;
  border: 1rpx solid #c9a86a;
  background: rgba(201, 168, 106, 0.1);
  color: #c9a86a;
  font-size: 30rpx;
  letter-spacing: 0.3em;
  /* 字距会在末尾多算空白，text-indent 补回来才真正居中 */
  text-indent: 0.3em;
  box-sizing: border-box;

  /* 文字居中：view 没有 button 的默认居中，要自己写 */
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit.is-disabled {
  opacity: 0.4;
}

/* ============================================================
   提示文字
   ============================================================ */

.warn {
  margin-top: 28rpx;
  font-size: 22rpx;
  letter-spacing: 0.06em;
  color: #5a5956;
  text-align: center;
  line-height: 1.7;
}

.error {
  margin-top: 28rpx;
  font-size: 22rpx;
  letter-spacing: 0.06em;
  color: #d9705f;
  text-align: center;
  line-height: 1.7;
}
