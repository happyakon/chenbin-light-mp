/* 相册解锁 */

.unlock-page {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: #0d0d0d;
  display: flex;
  flex-direction: column;
}

.status-bar {
  flex: 0 0 auto;
}

.nav {
  flex: 0 0 auto;
  padding: 12rpx 20rpx;
}

.back {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #c8c6c1;
  line-height: 1;
  padding-bottom: 6rpx;
}

.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 88rpx 140rpx;
}

/*
 * 锁图标区域
 *
 * 为什么要包装一层而不是直接用 emoji：
 *   单个 emoji 孤零零放在页面上很单薄，
 *   加一圈柔和的金色光晕和细环，和整个站点「暗色 + 金」的调性统一。
 *
 * 三层结构：
 *   .lock-glow  最外层柔光（径向渐变，低透明度）
 *   .lock-ring  中间细环（边框，很淡）
 *   .lock-icon  锁本身
 */
.lock-badge {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 44rpx;
}

/* 外层柔光 */
.lock-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 260rpx;
  height: 260rpx;
  margin-left: -130rpx;
  margin-top: -130rpx;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(201, 168, 106, 0.16) 0%,
    rgba(201, 168, 106, 0.06) 40%,
    rgba(201, 168, 106, 0) 70%
  );
}

/* 中间细环 */
.lock-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 160rpx;
  height: 160rpx;
  margin-left: -80rpx;
  margin-top: -80rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(201, 168, 106, 0.28);
  background: rgba(201, 168, 106, 0.04);
}

.lock-icon {
  position: relative;
  font-size: 64rpx;
  line-height: 1;
  /* 锁图标带一点暖色投影，显得有厚度 */
  text-shadow: 0 4rpx 16rpx rgba(201, 168, 106, 0.35);
}

.album-title {
  font-family: "Songti SC", "SimSun", serif;
  font-size: 48rpx;
  letter-spacing: 0.14em;
  color: #f0efec;
  text-align: center;
}

.hint {
  margin-top: 20rpx;
  font-size: 26rpx;
  letter-spacing: 0.06em;
  color: #8a8884;
  text-align: center;
}

.input-wrap {
  width: 100%;
  margin-top: 80rpx;
}

.input {
  width: 100%;
  height: 104rpx;
  border: 1rpx solid rgba(240, 239, 236, 0.14);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.02);
  color: #f0efec;
  font-size: 32rpx;
  letter-spacing: 0.1em;
  text-align: center;
  box-sizing: border-box;
}

.input-ph {
  color: #3d3c3a;
  font-size: 28rpx;
  letter-spacing: 0.06em;
}

/* 输错抖动 */
.is-shake {
  animation: shake 0.4s ease;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-14rpx); }
  40% { transform: translateX(14rpx); }
  60% { transform: translateX(-10rpx); }
  80% { transform: translateX(10rpx); }
}

.submit {
  /*
   * ★ 必须重置 button 的默认样式
   *
   * 微信小程序的 <button> 自带：
   *   · margin-left: auto; margin-right: auto;
   *   · padding-left: 14px; padding-right: 14px;
   *   · box-sizing: border-box（但 width:100% + padding 会溢出）
   *
   * 只写 width:100% 时，auto margin 和 padding 一起作用，
   * 按钮会比输入框窄、并且视觉上偏左（截图里的问题）。
   */
  width: 100%;
  height: 100rpx;
  margin: 32rpx 0 0 0;
  padding: 0;
  border-radius: 16rpx;
  border: 1rpx solid #c9a86a;
  background: rgba(201, 168, 106, 0.1);
  color: #c9a86a;
  font-size: 30rpx;
  letter-spacing: 0.3em;
  text-indent: 0.3em;
  line-height: 98rpx;
  box-sizing: border-box;
  /* 去掉 button 的默认圆角和最小宽度 */
  min-width: 0;
  overflow: visible;
}

/* 去掉 button 的 ::after 边框（小程序默认画一圈细边框） */
.submit::after {
  border: none;
}

.submit.is-disabled {
  opacity: 0.4;
}

.warn {
  margin-top: 48rpx;
  font-size: 22rpx;
  letter-spacing: 0.06em;
  color: #5a5956;
  text-align: center;
  line-height: 1.7;
}

.error {
  margin-top: 48rpx;
  font-size: 22rpx;
  letter-spacing: 0.06em;
  color: #d9705f;
  text-align: center;
  line-height: 1.7;
}
