/* ============================================================
   相册解锁页
   
   背景质感全部用 CSS 实现，不引任何图片：
     · 体积零增加
     · 不受网络影响，秒出
     · WXSS 兼容性可控（只用渐变和 transform，不用 filter/blur）
   ============================================================ */

.unlock-page {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: #0b0b0c;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ============================================================
   背景层
   
   每层都是绝对定位、铺满，pointer-events: none 不挡交互。
   ============================================================ */

.bg-layer {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
}

/* ---------- 1. 底层：极淡的斜向渐变，避免纯色死板 ---------- */
.bg-base {
  background: linear-gradient(
    168deg,
    #14141a 0%,
    #0d0d0f 42%,
    #0a0a0b 100%
  );
}

/* ---------- 2. 金色光晕：偏上，像一束灯打在墙上 ---------- */
.bg-glow {
  background: radial-gradient(
    120% 62% at 50% 26%,
    rgba(201, 168, 106, 0.13) 0%,
    rgba(201, 168, 106, 0.055) 32%,
    rgba(201, 168, 106, 0.018) 55%,
    rgba(201, 168, 106, 0) 76%
  );
}

/* ---------- 3. 网格纹理：细密，给暗面一点织物质感 ---------- */
.bg-grid {
  /*
   * 用两条 1px 渐变线重复，形成网格。
   * 间距 84rpx。
   *
   * 透明度选 0.035：
   *   太低（0.02）在中低亮度屏幕上看不见，白做；
   *   太高（0.06+）会显得像「表格」，抢主体。
   *   0.035 在深色背景下刚好看得出「有纹理」但不喧宾夺主。
   */
  background-image: linear-gradient(
      to right,
      rgba(240, 239, 236, 0.035) 1px,
      transparent 1px
    ),
    linear-gradient(
      to bottom,
      rgba(240, 239, 236, 0.035) 1px,
      transparent 1px
    );
  background-size: 84rpx 84rpx;
  background-position: center top;
}

/* ---------- 4/5. 上下压暗，把视线收到中间 ---------- */
.bg-band-top {
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0.55) 0%,
    rgba(0, 0, 0, 0.18) 14%,
    rgba(0, 0, 0, 0) 30%
  );
}

.bg-band-bottom {
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.6) 0%,
    rgba(0, 0, 0, 0.2) 16%,
    rgba(0, 0, 0, 0) 34%
  );
}

/* ============================================================
   导航与内容
   ============================================================ */

.status-bar {
  flex: 0 0 auto;
  position: relative;
  z-index: 2;
}

.nav {
  flex: 0 0 auto;
  padding: 12rpx 20rpx;
  position: relative;
  z-index: 2;
}

.back {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #c8c6c1;
  line-height: 1;
  padding-bottom: 6rpx;
}

.content {
  position: relative;
  z-index: 2;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 76rpx 120rpx;
}

/* ============================================================
   锁徽章
   
   60rpx 的 emoji 放大到 64rpx 会糊，
   所以用三层叠加造出「有厚度」的感觉：
     外层柔光 140rpx 扩散
     中层细环 160rpx 描边
     图标本身带暖色投影
   ============================================================ */

.lock-badge {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

/* 外层柔光：大范围、很淡 */
.lock-glow-outer {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 300rpx;
  height: 300rpx;
  margin-left: -150rpx;
  margin-top: -150rpx;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(201, 168, 106, 0.17) 0%,
    rgba(201, 168, 106, 0.07) 36%,
    rgba(201, 168, 106, 0.018) 58%,
    rgba(201, 168, 106, 0) 74%
  );
}

/* 内层柔光：小范围、更亮，做出「发光核心」 */
.lock-glow-inner {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 168rpx;
  height: 168rpx;
  margin-left: -84rpx;
  margin-top: -84rpx;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(201, 168, 106, 0.1) 0%,
    rgba(201, 168, 106, 0.03) 55%,
    rgba(201, 168, 106, 0) 75%
  );
}

/* 细环：冷金描边，让徽章有边界感 */
.lock-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 160rpx;
  height: 160rpx;
  margin-left: -80rpx;
  margin-top: -80rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(201, 168, 106, 0.26);
  box-sizing: border-box;
  /* 内圈再压一层极淡的填充，避免环内太空 */
  background: rgba(201, 168, 106, 0.022);
}

.lock-icon {
  position: relative;
  font-size: 62rpx;
  line-height: 1;
  /* 暖色投影，让图标像「浮」在光环上 */
  text-shadow: 0 6rpx 20rpx rgba(201, 168, 106, 0.42),
    0 2rpx 6rpx rgba(0, 0, 0, 0.5);
}

/* ============================================================
   标题
   ============================================================ */

.album-title {
  font-family: "Songti SC", "SimSun", serif;
  font-size: 48rpx;
  letter-spacing: 0.16em;
  text-indent: 0.16em;
  color: #f0efec;
  text-align: center;
  /* 极淡的暖色发光，和背景光晕呼应 */
  text-shadow: 0 2rpx 16rpx rgba(201, 168, 106, 0.18);
}

/* 标题下的短分隔线：金色渐变，两边淡出 */
.title-rule {
  width: 72rpx;
  height: 1rpx;
  margin-top: 22rpx;
  background: linear-gradient(
    90deg,
    rgba(201, 168, 106, 0) 0%,
    rgba(201, 168, 106, 0.5) 50%,
    rgba(201, 168, 106, 0) 100%
  );
}

.hint {
  margin-top: 24rpx;
  font-size: 26rpx;
  letter-spacing: 0.06em;
  color: #8a8884;
  text-align: center;
}

/* ============================================================
   输入框
   ============================================================ */

.input-wrap {
  width: 100%;
  margin-top: 72rpx;
}

.input {
  width: 100%;
  height: 104rpx;
  border: 1rpx solid rgba(240, 239, 236, 0.13);
  border-radius: 16rpx;
  /*
   * 输入框背景比页面略亮一点点，
   * 在暗色里能看出「这是个可以点的东西」。
   */
  background: rgba(255, 255, 255, 0.028);
  color: #f0efec;
  font-size: 32rpx;
  letter-spacing: 0.14em;
  text-align: center;
  box-sizing: border-box;
}

.input-ph {
  color: #3d3c3a;
  font-size: 28rpx;
  letter-spacing: 0.06em;
}

/* 输错抖动 */
.is-shake {
  animation: shake 0.4s ease;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-14rpx); }
  40% { transform: translateX(14rpx); }
  60% { transform: translateX(-10rpx); }
  80% { transform: translateX(10rpx); }
}

/* ============================================================
   按钮
   
   微信 <button> 自带 margin:auto 和 padding，
   必须重置，否则宽度不对、位置偏左。
   ============================================================ */

.submit {
  width: 100%;
  height: 100rpx;
  margin: 28rpx 0 0 0;
  padding: 0;
  border-radius: 16rpx;
  border: 1rpx solid rgba(201, 168, 106, 0.55);
  /*
   * 按钮用一点金色渐变，比纯色更有材质感
   */
  background: linear-gradient(
    180deg,
    rgba(201, 168, 106, 0.16) 0%,
    rgba(201, 168, 106, 0.08) 100%
  );
  color: #d8bd85;
  font-size: 30rpx;
  letter-spacing: 0.3em;
  text-indent: 0.3em;
  line-height: 98rpx;
  box-sizing: border-box;
  min-width: 0;
  overflow: visible;
}

.submit::after {
  border: none;
}

.submit.is-disabled {
  opacity: 0.4;
}

/* ============================================================
   提示文字
   ============================================================ */

.warn {
  margin-top: 44rpx;
  font-size: 22rpx;
  letter-spacing: 0.06em;
  color: #5a5956;
  text-align: center;
  line-height: 1.7;
}

.error {
  margin-top: 44rpx;
  font-size: 22rpx;
  letter-spacing: 0.06em;
  color: #d9705f;
  text-align: center;
  line-height: 1.7;
}
