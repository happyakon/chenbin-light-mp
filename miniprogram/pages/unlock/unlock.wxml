<view class="unlock-page">
  <!--
    背景质感分四层（全部纯 CSS，不引图片）：
      1. base-glow   径向金色光晕，偏上，模拟灯光打在墙上
      2. base-grid   细网格纹理，给平面加一点织物感
      3. band-top    顶部渐暗，压住状态栏区域
      4. band-bottom 底部渐暗，聚焦视线到中间
  -->
  <view class="bg-layer bg-base"></view>
  <view class="bg-layer bg-glow"></view>
  <view class="bg-layer bg-grid"></view>
  <view class="bg-layer bg-band-top"></view>
  <view class="bg-layer bg-band-bottom"></view>

  <view class="status-bar" style="height:{{statusBarHeight}}px"></view>

  <view class="nav">
    <view class="back" bindtap="goBack">‹</view>
  </view>

  <view class="content">
    <!--
      锁徽章：三层叠加
        · 外层柔光（大范围金色晕）
        · 中层细环（1rpx 冷金光圈）
        · 图标本身带暖色投影
    -->
    <view class="lock-badge">
      <view class="lock-glow-outer"></view>
      <view class="lock-glow-inner"></view>
      <view class="lock-ring"></view>
      <view class="lock-icon">🔒</view>
    </view>

    <view class="album-title">{{albumTitle || '该相册'}}</view>
    <view class="title-rule"></view>
    <view class="hint">请输入密码后查看</view>

    <view class="input-wrap {{shake ? 'is-shake' : ''}}">
      <input
        class="input"
        type="text"
        password
        value="{{password}}"
        placeholder="输入密码"
        placeholder-class="input-ph"
        confirm-type="done"
        disabled="{{submitting || retryAfter > 0}}"
        bindinput="onInput"
        bindconfirm="onSubmit"
        focus
      />
    </view>

    <button
      class="submit {{submitting || retryAfter > 0 ? 'is-disabled' : ''}}"
      disabled="{{submitting || retryAfter > 0}}"
      bindtap="onSubmit"
    >
      {{submitting ? '验证中…' : '进入'}}
    </button>

    <!-- 错误 / 锁定提示 -->
    <view wx:if="{{retryAfter > 0}}" class="warn">{{lockText}}</view>
    <view wx:elif="{{error}}" class="error">{{error}}</view>
    <view wx:else class="warn">连续错误 5 次将锁定 4 小时</view>
  </view>
</view>
